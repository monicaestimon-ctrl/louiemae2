# Louie Mae Environment Variables

# Admin Portal Password (defaults to 'louiemae' if not set)
VITE_ADMIN_PASSWORD=your_secure_password_here

# Google Gemini API Key (required for AI features)
# Get your key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Convex Deployment (auto-generated by Convex)
CONVEX_DEPLOYMENT=your_convex_deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
SITE_URL=https://louiemae.com

# CJ Dropshipping API (for dropshipping fulfillment)
# Register at: https://developers.cjdropshipping.com/
CJ_API_KEY=your_cj_api_key
CJ_WEBHOOK_URL=https://your-deployment.convex.site/cj/webhook
CJ_OPEN_ID=your_cj_open_id
# Optional fallback if CJ_OPEN_ID is not set.
CJ_WEBHOOK_OPEN_ID=your_cj_open_id

# CJ fulfillment automation switches
# Keep balance payment disabled until product mapping, inventory, and webhook verification are tested.
CJ_AUTO_FULFILLMENT_ENABLED=false
CJ_AUTO_BALANCE_PAY_ENABLED=false
CJ_WEBHOOK_VERIFY_SIGNATURE=true
CJ_REQUIRE_FULFILLMENT_READY_CHECKOUT=true
CJ_LOW_STOCK_THRESHOLD=5
CJ_ADMIN_EMAILS=owner@example.com,ops@example.com

# Stripe payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_live_or_test_secret
# Local/non-production only. Keep unset or false in production.
STRIPE_ALLOW_UNSIGNED_WEBHOOKS=false

# Transactional email
RESEND_API_KEY=your_resend_api_key

# Product sourcing/search
RAPIDAPI_KEY=your_rapidapi_key
USD_CNY_RATE=7.2
