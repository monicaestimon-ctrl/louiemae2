{
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/opt/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/images/brand/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=604800" }] },
    { "source": "/trade/decoders/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/trade/(c|f)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] }
  ],
  "redirects": [
    { "source": "/furniture", "destination": "/trade", "permanent": false },
    { "source": "/furniture/", "destination": "/trade", "permanent": false }
  ],
  "rewrites": [
    { "source": "/furniture/admin", "destination": "/furniture/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/trade", "destination": "/trade/index.html" },
    { "source": "/trade/", "destination": "/trade/index.html" },
    { "source": "/b/:slug", "destination": "/api/board?slug=:slug" },
    {
      "source": "/story",
      "destination": "/api/og?path=story"
    },
    {
      "source": "/blog",
      "destination": "/api/og?path=blog"
    },
    {
      "source": "/shop",
      "destination": "/api/og?path=shop"
    },
    {
      "source": "/collection/:type",
      "destination": "/api/og?path=collection/:type"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
