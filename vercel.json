{
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "functions": { "api/journal.ts": { "includeFiles": "dist/index.html" }, "api/page.ts": { "includeFiles": "dist/index.html" }, "api/product.ts": { "includeFiles": "dist/index.html" }, "api/collection.ts": { "includeFiles": "dist/index.html" } },
  "headers": [
    { "source": "/build-info.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" }
    ] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/opt/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/images/brand/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=604800" }] },
    { "source": "/trade/decoders/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/trade/(c|f)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/trade/m/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "redirects": [
    { "source": "/furniture", "destination": "/trade", "permanent": false },
    { "source": "/furniture/", "destination": "/trade", "permanent": false }
  ],
  "rewrites": [
    { "source": "/products/:id", "destination": "/api/product?id=:id" },
    { "source": "/furniture/admin", "destination": "/furniture/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/trade", "destination": "/trade/index.html" },
    { "source": "/trade/", "destination": "/trade/index.html" },
    { "source": "/b/:slug", "destination": "/api/board?slug=:slug" },
    {
      "source": "/story",
      "destination": "/api/page?id=story"
    },
    {
      "source": "/blog",
      "destination": "/api/journal"
    },
    { "source": "/blog/:id", "destination": "/api/journal?id=:id" },
    {
      "source": "/shop",
      "destination": "/api/page?id=shop"
    },
    {
      "source": "/collection/:type",
      "destination": "/api/collection?id=:type"
    },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/r/:linkId([a-z0-9]{8,24})", "destination": "/index.html" },
    {
      "source": "/((?!api).*)",
      "destination": "/api/not-found"
    }
  ]
}
